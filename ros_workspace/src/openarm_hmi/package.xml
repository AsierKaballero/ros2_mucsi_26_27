<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarm_hmi</name>
  <version>0.1.0</version>
  <description>HMI web para manejar los dos brazos de los cuerpos OpenArm (301, 302) del laboratorio:
    movimiento articular y cartesiano, velocidad, pinzas, poses, cámaras, gemelo digital 3D,
    introspección de ROS 2, parada de emergencia, arranque/parada del sistema y scripts de prueba.</description>
  <maintainer email="laboratorio@todo.todo">laboratorio</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- Mallas del robot (gemelo digital) y lanzadores sim_/robot_<cuerpo>.launch.py -->
  <exec_depend>launcher_robots_lab_robotica</exec_depend>
  <!-- Solo para launch/camaras.launch.py (cámaras USB reales) -->
  <exec_depend>usb_cam</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
